
@model DemoMVC.ViewModels.UserRoleViewModel

@{
    ViewData["Title"] = "Gán vai trò";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Gán vai trò cho người dùng</h4>
        </div>

        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Họ tên</label>
                <input class="form-control"
                       value="@Model.FullName"
                       readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control"
                       value="@Model.Email"
                       readonly />
            </div>

            <form asp-action="ManageRoles" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="UserId" />

                <h5 class="mb-3">Chọn vai trò</h5>

                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    <div class="form-check mb-2">
                        <input type="hidden"
                               asp-for="Roles[i].RoleName" />

                        <input class="form-check-input"
                               asp-for="Roles[i].IsSelected" />

                        <label class="form-check-label"
                               asp-for="Roles[i].IsSelected">
                            @Model.Roles[i].RoleName
                        </label>
                    </div>
                }

                @if (Model.Roles.Count == 0)
                {
                    <p class="text-muted">
                        Chưa có Role nào. Hãy tạo Role trước.
                    </p>
                }

                <hr />

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Lưu phân quyền
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>
