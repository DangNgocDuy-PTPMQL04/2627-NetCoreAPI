
@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary"></i>
                Quản lý sinh viên
            </h2>
            <p class="text-muted mb-0">
                Thêm, sửa, xóa và tìm kiếm thông tin sinh viên
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                onclick="openAddModal()">
            <i class="bi bi-plus-circle"></i>
            Thêm sinh viên
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="keyword"
                               class="form-control"
                               placeholder="Tìm mã sinh viên, họ tên, địa chỉ, trường, khoa..." />

                        <button class="btn btn-outline-secondary"
                                type="button"
                                onclick="searchStudents()">
                            Tìm kiếm
                        </button>
                    </div>
                </div>

                <div class="col-md-3">
                    <select id="pageSize"
                            class="form-select"
                            onchange="loadStudents(1)">
                        <option value="5">5 dòng / trang</option>
                        <option value="10">10 dòng / trang</option>
                        <option value="20">20 dòng / trang</option>
                        <option value="50">50 dòng / trang</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width:60px">STT</th>
                            <th>Mã sinh viên</th>
                            <th>Họ và tên</th>
                            <th>Địa chỉ</th>
                            <th>Trường</th>
                            <th>Khoa</th>
                            <th class="text-center" style="width:150px">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody id="studentTable">
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                Đang tải dữ liệu...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div id="paginationInfo" class="text-muted small"></div>
                <nav>
                    <ul class="pagination mb-0" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Modal thêm / sửa sinh viên -->
<div class="modal fade" id="studentModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">
                    Thêm sinh viên
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form id="studentForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden" id="Id" name="Id" value="0" />

                    <div id="formMessage"
                         class="alert alert-danger d-none">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mã sinh viên</label>
                        <input type="text"
                               id="StudentCode"
                               class="form-control"
                               placeholder="Mã sinh viên được tự động tạo"
                               disabled />

                        <small class="text-muted">
                            Mã sinh viên sẽ được hệ thống tự động tạo khi thêm mới.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Họ và tên <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="FullName"
                               name="FullName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Nhập họ và tên sinh viên" />

                        <small class="text-danger" data-error="FullName"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>

                        <input type="text"
                               id="Address"
                               name="Address"
                               class="form-control"
                               maxlength="200"
                               placeholder="Nhập địa chỉ" />

                        <small class="text-danger" data-error="Address"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Trường</label>

                        <input type="text"
                               id="University"
                               name="University"
                               class="form-control"
                               maxlength="100"
                               placeholder="Nhập tên trường" />

                        <small class="text-danger" data-error="University"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Khoa <span class="text-danger">*</span>
                        </label>

                        <select id="FacultyId"
                                name="FacultyId"
                                class="form-select">
                            <option value="">-- Chọn khoa --</option>
                        </select>

                        <small class="text-danger" data-error="FacultyId"></small>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnSave">
                        <i class="bi bi-save"></i>
                        Lưu thông tin
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let studentModal;

        const listUrl = '@Url.Action("List", "Student")';
        const getUrl = '@Url.Action("Get", "Student")';
        const facultiesUrl = '@Url.Action("Faculties", "Student")';
        const saveUrl = '@Url.Action("Save", "Student")';
        const deleteUrl = '@Url.Action("Delete", "Student")';

        $(document).ready(function () {
            studentModal = new bootstrap.Modal(
                document.getElementById("studentModal")
            );

            loadFaculties();
            loadStudents(1);

            $("#keyword").on("keydown", function (e) {
                if (e.key === "Enter") {
                    searchStudents();
                }
            });
        });

        function getToken() {
            return $("#studentForm input[name='__RequestVerificationToken']").val();
        }

        function showMessage(message) {
            $("#formMessage")
                .removeClass("d-none")
                .text(message);
        }

        function clearErrors() {
            $("#formMessage")
                .addClass("d-none")
                .text("");

            $("[data-error]").text("");
        }

        function loadFaculties(selectedId = "") {
            $.get(facultiesUrl, function (response) {
                if (!response.success) {
                    alert("Không thể tải danh sách khoa.");
                    return;
                }

                let html = '<option value="">-- Chọn khoa --</option>';

                response.data.forEach(function (faculty) {
                    html += `
                        <option value="${faculty.id}">
                            ${escapeHtml(faculty.name)}
                        </option>
                    `;
                });

                $("#FacultyId").html(html);

                if (selectedId !== "" && selectedId != null) {
                    $("#FacultyId").val(String(selectedId));
                }
            }).fail(function () {
                alert("Lỗi khi tải danh sách khoa.");
            });
        }

        function loadStudents(page = 1) {
            currentPage = page;

            $.get(listUrl, {
                keyword: $("#keyword").val(),
                page: currentPage,
                pageSize: $("#pageSize").val()
            }, function (response) {

                if (!response.success) {
                    $("#studentTable").html(`
                        <tr>
                            <td colspan="7" class="text-center text-danger">
                                Không thể tải danh sách sinh viên.
                            </td>
                        </tr>
                    `);
                    return;
                }

                const result = response.data;
                totalPages = result.totalPages;

                let html = "";

                if (result.items.length === 0) {
                    html = `
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                Không tìm thấy sinh viên nào.
                            </td>
                        </tr>
                    `;
                } else {
                    result.items.forEach(function (student, index) {
                        const stt =
                            (result.page - 1) * result.pageSize + index + 1;

                        html += `
                            <tr>
                                <td class="text-center">${stt}</td>
                                <td>${escapeHtml(student.studentCode || "")}</td>
                                <td>${escapeHtml(student.fullName || "")}</td>
                                <td>${escapeHtml(student.address || "")}</td>
                                <td>${escapeHtml(student.university || "")}</td>
                                <td>${escapeHtml(student.facultyName || "")}</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-warning"
                                            onclick="editStudent(${student.id})">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                            onclick="deleteStudent(${student.id})">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                }

                $("#studentTable").html(html);

                $("#paginationInfo").text(
                    `Tổng ${result.totalCount} sinh viên | Trang ${result.page} / ${result.totalPages || 1}`
                );

                renderPagination(result.page, result.totalPages);
            }).fail(function () {
                $("#studentTable").html(`
                    <tr>
                        <td colspan="7" class="text-center text-danger">
                            Lỗi khi tải dữ liệu sinh viên.
                        </td>
                    </tr>
                `);
            });
        }

        function renderPagination(page, pages) {
            let html = "";

            if (pages <= 1) {
                $("#pagination").html("");
                return;
            }

            html += `
                <li class="page-item ${page <= 1 ? "disabled" : ""}">
                    <button class="page-link"
                            onclick="loadStudents(${page - 1})">
                        Trước
                    </button>
                </li>
            `;

            for (let i = 1; i <= pages; i++) {
                html += `
                    <li class="page-item ${i === page ? "active" : ""}">
                        <button class="page-link"
                                onclick="loadStudents(${i})">
                            ${i}
                        </button>
                    </li>
                `;
            }

            html += `
                <li class="page-item ${page >= pages ? "disabled" : ""}">
                    <button class="page-link"
                            onclick="loadStudents(${page + 1})">
                        Sau
                    </button>
                </li>
            `;

            $("#pagination").html(html);
        }

        function searchStudents() {
            loadStudents(1);
        }

        function openAddModal() {
            $("#studentForm")[0].reset();

            $("#Id").val(0);
            $("#StudentCode").val("");

            clearErrors();

            $("#modalTitle").text("Thêm sinh viên");

            loadFaculties();

            studentModal.show();
        }

        function editStudent(id) {
            clearErrors();

            $.get(getUrl, { id: id }, function (response) {
                if (!response.success) {
                    alert(response.message || "Không tìm thấy sinh viên.");
                    return;
                }

                const student = response.data;

                $("#Id").val(student.id);
                $("#StudentCode").val(student.studentCode || "");
                $("#FullName").val(student.fullName || "");
                $("#Address").val(student.address || "");
                $("#University").val(student.university || "");

                $("#modalTitle").text("Cập nhật sinh viên");

                loadFaculties(student.facultyId);

                studentModal.show();
            }).fail(function (xhr) {
                alert(xhr.responseJSON?.message ||
                    "Không thể tải thông tin sinh viên.");
            });
        }

        $("#studentForm").on("submit", function (e) {
            e.preventDefault();

            clearErrors();

            const facultyId = $("#FacultyId").val();

            if (!facultyId) {
                $("[data-error='FacultyId']")
                    .text("Vui lòng chọn khoa.");

                return;
            }

            const saveButton = $("#btnSave");

            saveButton.prop("disabled", true)
                .html('<span class="spinner-border spinner-border-sm"></span> Đang lưu...');

            $.ajax({
                url: saveUrl,
                type: "POST",

                // serialize() bao gồm cả token chống giả mạo.
                data: $(this).serialize(),

                success: function (response) {
                    if (response.success) {
                        studentModal.hide();

                        alert(response.message);

                        loadStudents(currentPage);
                    } else {
                        showMessage(
                            response.message || "Không thể lưu sinh viên."
                        );
                    }
                },

                error: function (xhr) {
                    const response = xhr.responseJSON;

                    if (response && response.errors) {
                        Object.keys(response.errors).forEach(function (key) {
                            $(`[data-error='${key}']`)
                                .text(response.errors[key].join(", "));
                        });

                        showMessage(
                            response.message ||
                            "Vui lòng kiểm tra lại thông tin."
                        );

                        return;
                    }

                    showMessage(
                        response?.detail ||
                        response?.message ||
                        "Có lỗi xảy ra khi lưu sinh viên. Hãy kiểm tra lại dữ liệu."
                    );
                },

                complete: function () {
                    saveButton.prop("disabled", false)
                        .html('<i class="bi bi-save"></i> Lưu thông tin');
                }
            });
        });

        function deleteStudent(id) {
            if (!confirm("Bạn có chắc chắn muốn xóa sinh viên này không?")) {
                return;
            }

            $.ajax({
                url: deleteUrl,
                type: "POST",
                data: {
                    id: id,
                    __RequestVerificationToken: getToken()
                },

                success: function (response) {
                    alert(response.message || "Đã xóa sinh viên.");

                    loadStudents(currentPage);
                },

                error: function (xhr) {
                    alert(
                        xhr.responseJSON?.message ||
                        "Không thể xóa sinh viên."
                    );
                }
            });
        }

        function escapeHtml(value) {
            return String(value ?? "").replace(/[&<>"']/g, function (char) {
                return {
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#039;"
                }[char];
            });
        }
    </script>
}
