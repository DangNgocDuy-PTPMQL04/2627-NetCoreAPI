
@model List<DemoMVC.ViewModels.RoleViewModel>

@{
    ViewData["Title"] = "Quản lý vai trò";
    var userCounts = ViewBag.UserCounts
        as Dictionary<string, int>
        ?? new Dictionary<string, int>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Quản lý vai trò</h3>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm vai trò
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px">STT</th>
                            <th>Tên vai trò</th>
                            <th style="width: 180px">Số người dùng</th>
                            <th style="width: 190px">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center">
                                    Chưa có vai trò nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var role = Model[i];
                                var count = userCounts.ContainsKey(role.Id)
                                    ? userCounts[role.Id] : 0;

                                bool systemRole =
                                    role.Name.Equals("Admin",
                                        StringComparison.OrdinalIgnoreCase)
                                    || role.Name.Equals("User",
                                        StringComparison.OrdinalIgnoreCase);

                                <tr>
                                    <td>@(i + 1)</td>

                                    <td>
                                        <strong>@role.Name</strong>

                                        @if (systemRole)
                                        {
                                            <span class="badge bg-secondary ms-2">
                                                Hệ thống
                                            </span>
                                        }
                                    </td>

                                    <td>@count</td>

                                    <td>
                                        @if (!systemRole)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@role.Id"
                                               class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                                Sửa
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@role.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa vai trò này?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                    Xóa
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Không thể chỉnh sửa
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
