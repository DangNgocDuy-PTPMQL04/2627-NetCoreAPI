
@model DemoMVC.Models.RolePermissionViewModel

@{
    ViewData["Title"] = "Quản lý phân quyền";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-shield-lock"></i>
                Quản lý phân quyền
            </h3>
            <p class="text-muted mb-0">
                Cấp và thu hồi quyền truy cập theo từng Role.
            </p>
        </div>
    </div>

    @if (TempData["PermissionMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["PermissionMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Roles.Any())
    {
        <!-- Chọn Role -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="row align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">
                                Chọn vai trò
                            </label>

                            <select name="roleId"
                                    class="form-select"
                                    asp-items="Model.Roles">
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-search"></i>
                                Xem quyền
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Danh sách quyền -->
        <form asp-action="Save" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="RoleId" />

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">
                                Quyền của Role: @Model.RoleName
                            </h5>

                            <small class="text-muted">
                                Đã chọn @Model.SelectedPermissionIds.Count
                                quyền
                            </small>
                        </div>

                        @if (Model.IsAdmin)
                        {
                            <span class="badge bg-success">
                                Toàn quyền quản trị
                            </span>
                        }
                    </div>
                </div>

                <div class="card-body">

                    @if (Model.IsAdmin)
                    {
                        <div class="alert alert-info">
                            Role Admin luôn có toàn quyền.
                            Không thể thay đổi quyền của Role này tại đây.
                        </div>
                    }

                    @foreach (var group in Model.Groups)
                    {
                        <div class="border rounded p-3 mb-3">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0 text-primary">
                                    <i class="bi bi-folder"></i>
                                    @group.Controller
                                </h5>

                                <span class="badge bg-secondary">
                                    @group.Permissions.Count Action
                                </span>
                            </div>

                            <div class="row">
                                @foreach (var permission in group.Permissions)
                                {
                                    var isChecked =
                                        Model.SelectedPermissionIds.Contains(permission.Id);

                                    <div class="col-md-4 col-lg-3 mb-3">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedPermissionIds"
                                                   value="@permission.Id"
                                                   id="permission_@permission.Id"
                                                   checked="@(isChecked ? "checked" : null)"
                                                   disabled="@(Model.IsAdmin ? "disabled" : null)" />

                                            <label class="form-check-label"
                                                   for="permission_@permission.Id">
                                                @permission.Action
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!Model.Groups.Any())
                    {
                        <div class="alert alert-warning">
                            Chưa có dữ liệu quyền.
                        </div>
                    }

                </div>

                @if (!Model.IsAdmin)
                {
                    <div class="card-footer bg-white text-end">
                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-save"></i>
                            Lưu phân quyền
                        </button>
                    </div>
                }

            </div>
        </form>
    }
    else
    {
        <div class="alert alert-warning">
            Chưa có Role trong hệ thống.
        </div>
    }

</div>